# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude code local settings (may contain API keys)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP config — contains Supabase access token, never commit
.mcp.json

# DataForSEO raw dumps that are large, regenerable, and not read by any script.
# The analyze-*.js scripts read only the small derived files, which stay tracked.
#   phase35-ranked-keywords.json — 24MB of full API responses; ~1% of its fields were
#     ever used, and the used part is already in phase35-keyword-universe.json.
#     Regenerate with: node scripts/seo/competitor-keywords.js  (~$0.53 of API spend)
#   phase35-user-data.json — account balance check; contains the account login email.
docs/seo/raw/phase35-ranked-keywords.json
docs/seo/raw/phase35-user-data.json
